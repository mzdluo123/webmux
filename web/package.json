{
  "name": "webmux-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "build": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings && vite build",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:test": "svelte-check --tsgo --tsconfig ./tsconfig.test.json --fail-on-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "arch:lint": "eslint src",
    "arch:deps": "depcruise src --ignore-known",
    "arch:dupes": "jscpd -c .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones=0",
    "arch:unused": "knip",
    "arch:test": "vitest run --config vitest.config.ts test/architecture.test.ts",
    "arch:ratchet": "eslint src --prune-suppressions && depcruise src --baseline .dependency-cruiser-known-violations.json --baseline-mode shrink-only && pnpm run arch:dupes && jscpd -c .jscpd.json --baseline .jscpd-baseline.json --update-baseline && oxfmt eslint-suppressions.json .dependency-cruiser-known-violations.json .jscpd-baseline.json",
    "check:arch": "pnpm run arch:lint && pnpm run arch:deps && pnpm run arch:dupes && pnpm run arch:unused && pnpm run arch:test",
    "dev": "vite --host 127.0.0.1",
    "test": "pnpm run test:unit && pnpm run test:browser && pnpm run test:storybook && pnpm run test:e2e && pnpm run test:performance",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "pnpm run test:coverage:unit && pnpm run test:coverage:browser && pnpm run test:coverage:merge",
    "test:coverage:unit": "vitest run --config vitest.config.ts --coverage.enabled",
    "test:coverage:browser": "vitest run --config vitest.browser.config.ts --coverage.enabled",
    "test:coverage:merge": "node scripts/merge-coverage.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:hero": "node scripts/hero.mjs",
    "test:e2e:report": "playwright show-report playwright-report/e2e",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "check:storybook": "svelte-check --tsgo --tsconfig .storybook/tsconfig.json --fail-on-warnings",
    "build-storybook": "pnpm run check:storybook && storybook build",
    "test:storybook": "pnpm run build-storybook && playwright test --config playwright.storybook.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "@pierre/diffs": "1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "motion": "^14.12.0",
    "pdfjs-dist": "^6.5.438",
    "svelte": "^5.57.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.44",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@storybook/svelte-vite": "10.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons-svelte": "^3.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "bits-ui": "^2.20.6",
    "cn": "^0.5.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fflate": "0.8.3",
    "jscpd": "^5.4.3",
    "knip": "^6.44.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "paneforge": "^1.0.2",
    "playwright": "^1.65.0",
    "shadcn-svelte": "^1.8.0",
    "storybook": "10.6.6",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  }
}
