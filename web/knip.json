{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.{ts,mjs}"],
  "project": [
    "src/**/*.{ts,svelte,css}",
    "scripts/**/*.{ts,mjs}",
    "test/**/*.ts"
  ],
  "ignore": ["src/lib/components/ui/**"],
  "ignoreDependencies": ["@typescript/native", "shadcn-svelte"],
  "rules": {
    "files": "error",
    "duplicates": "error",
    "dependencies": "error",
    "exports": "error",
    "types": "error"
  }
}
