# Installs a newer signed WebMux deb/rpm release; started daily by
# webmux-update.timer. It never starts, stops or restarts any user's
# webmux.service: running servers use the new version after their users
# restart them. Set a proxy with a drop-in, for example:
#   systemctl edit webmux-update.service
#   [Service]
#   Environment=HTTPS_PROXY=http://proxy.example:3128
#
# The check and download stop after 30 minutes; a started dpkg or rpm always
# finishes. Stopping the unit signals only webmux, which waits for the
# package manager, so it is never killed mid-install. The package manager
# inherits this unit's settings, so none lower its priority or block its
# scriptlets (NoNewPrivileges= would stop their SELinux domain transitions).
[Unit]
Description=WebMux automatic update
Documentation=https://github.com/mzdluo123/webmux/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/webmux update apply
CacheDirectory=webmux-update
CacheDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
KillMode=process
TimeoutStartSec=1h
TimeoutStopSec=15min
